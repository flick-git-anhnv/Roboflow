# KZTEK Labeling Studio — Server environment variables
# Copy sang .env và điền giá trị thực trước khi chạy production

# ── Auth ──────────────────────────────────────────────────────────────────────
# BẮT BUỘC khi NODE_ENV=production. Min 32 ký tự.
# Sinh bằng: openssl rand -hex 32
AUTH_JWT_SECRET=change-me-min-32-chars-please-generate-with-openssl-rand-hex-32

# Bootstrap admin được tạo tự động khi DB còn rỗng (lần đầu khởi động).
# Nếu không set: mặc định admin/kztek@2026 — ĐỔI NGAY SAU KHI LOGIN LẦN ĐẦU
AUTH_BOOTSTRAP_ADMIN_USER=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=change-me-first-login

# Set 1 để bật Secure flag trên cookie kztek_token (bắt buộc khi dùng HTTPS)
AUTH_COOKIE_SECURE=1

# ── CORS ──────────────────────────────────────────────────────────────────────
# Origin client được phép gọi API. Nhiều origin cách nhau dấu phẩy.
CORS_ORIGIN=http://localhost:5173

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
# NODE_ENV=production

# ── Emergency rollback (dùng khi auth bị broken, tắt lại ngay) ───────────────
# AUTH_DISABLED=1
